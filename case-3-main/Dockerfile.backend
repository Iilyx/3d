# case-3 backend — FastAPI + Playwright Chromium + XeLaTeX + Pandoc + LibreOffice
# Chromium: файлы из распакованного chrome-linux64.zip → vendor/chrome-linux64/
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CASE3_ROOT=/app \
    CASE3_TEX_LOCAL=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

RUN apt-get update && \
    apt-get install --no-install-recommends -y \
      ca-certificates \
      curl \
      libatomic1 \
      latexmk \
      lmodern \
      texlive-xetex \
      texlive-lang-cyrillic \
      texlive-latex-recommended \
      texlive-latex-extra \
      texlive-fonts-recommended \
      fonts-dejavu \
      fonts-liberation \
      pandoc \
      libreoffice-impress \
      libreoffice-writer \
    && apt-get --purge remove -y '.*-doc$' \
    && apt-get clean -y

WORKDIR /app

COPY pyproject.toml ./
COPY src ./src
COPY prompt ./prompt
COPY assets ./assets

# Распакованный zip: внутри должна быть папка с бинарником chrome
COPY vendor/chrome-linux64 /opt/chrome-linux64

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir . && \
    REV="$(python -c "import json, pathlib, playwright; \
root = pathlib.Path(playwright.__file__).parent; \
p = next(root.rglob('browsers.json')); \
print(next(b['revision'] for b in json.loads(p.read_text())['browsers'] if b['name']=='chromium'))")" && \
    mkdir -p "/ms-playwright/chromium-${REV}" && \
    cp -a /opt/chrome-linux64 "/ms-playwright/chromium-${REV}/chrome-linux64" && \
    touch "/ms-playwright/chromium-${REV}/INSTALLATION_COMPLETE" && \
    python -m playwright install-deps chromium && \
    rm -rf /opt/chrome-linux64 && \
    apt-get clean -y && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p /app/runs/out /app/runs/work /app/runs/uploads /app/runs/logs /app/local

EXPOSE 8000

CMD ["uvicorn", "case3.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
