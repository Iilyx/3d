# Copy to .env  (не коммитить .env — только локально)
# Windows / lab: Qwen (основной путь)
VISION_API_BASE_URL=http://192.168.x.x:8080
# VISION_API_KEY=
# VISION_MODEL=
# Home-only tip (не для Windows/Qwen): OpenRouter — раскомментируй у себя, в git не пушь ключи
# VISION_API_BASE_URL=https://openrouter.ai/api
# VISION_API_KEY=sk-or-v1-...
# Резервные ключи при 429/лимитах (через запятую или в VISION_FALLBACK_API_KEYS):
# VISION_FALLBACK_API_KEYS=sk-or-v1-fallback-1,sk-or-v1-fallback-2
# VISION_MODEL=nvidia/nemotron-3.5-lightning:free
# 429 rate limit на :free — подожди ~1 мин ИЛИ смени модель / ключ:
# VISION_MODEL=openrouter/free
# VISION_MODEL=google/gemini-2.0-flash-exp:free
# платный ключ OpenRouter / локальный Qwen (VISION_API_BASE_URL офиса) — без free-лимита
VISION_TIMEOUT_S=300
# low/medium/high = thinking; если пустой ответ / нет \\documentclass → off
VISION_REASONING=off
# LAN GGUF (Qwen 3.5 4B): 4096 — иначе HTTP 500 «Context size exceeded».
# OpenRouter / большой ctx: можно 16384.
# Desk Win 073916/070133: 4096 truncates JSON→charts-only then sparse-fills skeleton Source.
# Prefer ≥12288 when CASE3_MAX_CHARTS≥4; ≥16384 when ≥6 charts (chart HTML is huge).
# Code bumps a floor at runtime, but setting 4096 on Win LAN GGUF still truncates early.
VISION_MAX_TOKENS=16384

CASE3_IMAGE=case-3:tex

# Office Image API (FastAPI: POST /generate + POST /edit) — не путать с Vision/Qwen
# Пример офиса: http://192.168.4.101:8000
IMAGE_API_BASE_URL=http://192.168.4.101:8000
# Потолок фото в документе (0 = off). Алиас: KANDINSKY_MAX_IMAGES.
# Если IMAGE_API_BASE_URL задан, а эта строка отсутствует — код берёт 2
# (иначе Liber шлёт max_images=0 → «без фото» и /generate не зовётся).
IMAGE_MAX_IMAGES=2
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
IMAGE_STEPS=4
IMAGE_GUIDANCE=3
IMAGE_SEED=0
IMAGE_TIMEOUT_S=180
# IMAGE_API_KEY=
# IMAGE_ALLOW_URL_DOWNLOAD=0
# Back-compat aliases (optional):
# KANDINSKY_API_BASE_URL=
# KANDINSKY_MAX_IMAGES=0

# Единственная переменная бюджета графиков (0 = off). Не дублировать другими именами.
# UI «Графиков ≤» overrides per request; env is bootstrap default + CLI fallback.
# For 4–5 charts raise VISION_MAX_TOKENS (≥12288) — chart HTML is huge.
CASE3_MAX_CHARTS=5
# Floor in code is 45s (Win 091728 with 15s → bar/line READY timeouts).
CASE3_CHART_TIMEOUT_S=45
# Mermaid Liber UI-only (0–5; default 5). Sole diagrams ceiling for API + Settings.
CASE3_MAX_DIAGRAMS=5
# Force second LLM diagram-repair pass in diagram mode (default off).
# CASE3_DIAGRAM_REPAIR=1
# Native OOXML charts in DOCX (default on, Word-safe cache-only). Set 0 to keep PNG.
# CASE3_DOCX_NATIVE_CHARTS=0

# LibreOffice for deck PDF twin (optional; PNG-stitch fallback otherwise).
# CASE3_SOFFICE=/Applications/LibreOffice.app/Contents/MacOS/soffice
# LIBREOFFICE_PATH=
